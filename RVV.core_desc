        extern unsigned<8> vslidedown_vx(void* pV, void* pR, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pRs1, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL, unsigned<8> pXLEN);
        extern unsigned<8> vslide1up_vx(void* pV, void* pR, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pRs1, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL, unsigned<8> pXLEN);
        extern unsigned<8> vslide1down_vx(void* pV, void* pR, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pRs1, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL, unsigned<8> pXLEN);

        // 16.4. Vector Register Gather Instructions
        extern unsigned<8> vrgather_vv(void* pV, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs1, unsigned<8> pVs2, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL);
        extern unsigned<8> vrgatherei16_vv(void* pV, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs1, unsigned<8> pVs2, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL);
        extern unsigned<8> vrgather_vi(void* pV, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pVimm, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL);
        extern unsigned<8> vrgather_vx(void* pV, void* pR, unsigned<16> pVTYPE, unsigned<8> pVm, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pRs1, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL, unsigned<8> pXLEN);

        // 16.5. Vector Compress Instruction
        extern unsigned<8> vcompress_vm(void* pV, unsigned<16> pVTYPE, unsigned<8> pVd, unsigned<8> pVs1, unsigned<8> pVs2, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL);

        // 16.6. Whole Vector Register Move
        extern unsigned<8> vmvr_v(void* pV, unsigned<16> pVTYPE, unsigned<8> pVd, unsigned<8> pVs2, unsigned<8> pVimm, unsigned<16> pVSTART, unsigned<32> pVLEN, unsigned<32> pVL);

    }
    instructions {
        // -- Configuration-Setting Instructions
        VSETVLI {
            // encoding: 1'b0 :: 1'b0 :: zimm[9:0] :: uimm[4:0] :: 3'b111 :: rd[4:0] :: 7'b1010111;
            encoding: 1'b0 :: zimm[10:0] :: rs1[4:0] :: 3'b111 :: rd[4:0] :: 7'b1010111;
            assembly:"{name(rd)}, {name(rs1)}, {zimm}";
            behavior: {
                // if(!(CSR[RV_CSR_MSTATUS] & RV_MSTATUS_VS)){
                //     raise(0, 2);  // vpu not enabled
                // }

                // unsigned<3> sew[3]  = vtype_extractSEW(zimm);
                // unsigned<3> lmul[3] = vtype_extractLMUL(zimm);
                // unsigned<1> vta[1]  = vtype_extractTA(zimm);
                // unsigned<1> vma[1]  = vtype_extractMA(zimm);
                unsigned<3> sew  = vtype_extractSEW(zimm);
                unsigned<3> lmul = vtype_extractLMUL(zimm);
                unsigned<1> vta  = vtype_extractTA(zimm);
                unsigned<1> vma  = vtype_extractMA(zimm);

                unsigned<32> vtype_result = zimm;
                unsigned<32> _vlmax = 0;
                // unsigned<32> _illmask = 0;

                unsigned<32> vlen = CSR[VLENB_ADDR]*8;

                if (sew == 0b011 && XLEN == 32) {
                    vtype_result = (1 << (XLEN - 1));
                }

                if (lmul & 4) {
                    // _illmask = (1 << (XLEN-1));
                    if(lmul == 6) {
                        _vlmax = vlen / (0x8 << sew) / 4;
                    } else if(lmul == 7) {
                        _vlmax = vlen / (0x8 << sew) / 2;
                    } else {
                        // For XLEN=32: unsupported!
                        if (XLEN == 32) {
                            vtype_result = (1 << (XLEN - 1));
                        } else {
                            _vlmax = vlen / (0x8 << sew) / 8;
                        }
                        // _vlmax = vlen / (0x8 << sew) / 8;
                    }
                } else {
                    // _illmask = (0 << (XLEN-1));
                    if(lmul == 0) {
                        _vlmax = vlen / (0x8 << sew);
                    } else if(lmul == 1) {
                        _vlmax = vlen / (0x8 << sew) *2;
                    } else if(lmul == 2) {
                        _vlmax = vlen / (0x8 << sew) *4;
                    } else if(lmul == 3) {
                        _vlmax = vlen / (0x8 << sew) *8;
                    }
                }

                unsigned<32> _avl = 0;
                if (rs1 != 0){
                    _avl = X[rs1];
                }else if(rd != 0){
                    _avl = ~0;
                }else{
                    _avl = CSR[VL_ADDR];
                }

                unsigned<32> _vl = 0;

                if(_avl <= _vlmax) {
                   _vl = _avl;
                } else if(_avl >= (2*_vlmax)) {
                   _vl = _vlmax;
                } else {
                  // TODO: check
                  // _vl = (_avl % 0x2) ?  _avl/2 + 1 : _avl / 2; // ceil (AVL/2)
                  _vl = _vlmax;
                }

                CSR[VL_ADDR] = _vl;
                // CSR[VTYPE_ADDR] = _illmask | zimm;
                CSR[VTYPE_ADDR] = vtype_result;
                if(rd != 0) X[rd] = _vl;
                CSR[VSTART_ADDR] = 0;
            }
        }

        VSETIVLI {
            encoding: 1'b1 :: 1'b1 :: vtypei[9:0] :: uimm[4:0] :: 3'b111 :: rd[4:0] :: 7'b1010111;
            assembly:"{name(rd)}, {uimm}, {vtypei}";
            behavior: {
                // TODO: Missing
                // unsigned<3> sew[3]  = vtype_extractSEW(vtypei);
                // unsigned<3> lmul[3] = vtype_extractLMUL(vtypei);
                // unsigned<1> vta[1]  = vtype_extractTA(vtypei);
                // unsigned<1> vma[1]  = vtype_extractMA(vtypei);
                unsigned<3> sew  = vtype_extractSEW(vtypei);
                unsigned<3> lmul = vtype_extractLMUL(vtypei);
                unsigned<1> vta  = vtype_extractTA(vtypei);
                unsigned<1> vma  = vtype_extractMA(vtypei);

                unsigned<32> _vlmax = 0;
                unsigned<32> vtype_result = vtypei;
                unsigned<32> vlen = CSR[VLENB_ADDR] * 8;

                if (sew == 0b011 && XLEN == 32) {
                    vtype_result = (1 << (XLEN - 1));
                }

                if (lmul & 4) {
                    if(lmul == 6) {
                        _vlmax = vlen / (0x8 << sew) / 4;
                    } else if(lmul == 7) {
                        _vlmax = vlen / (0x8 << sew) / 2;
                    } else {
                        // For XLEN=32: unsupported!
                        if (XLEN == 32) {
                            vtype_result = (1 << (XLEN - 1));
                        } else {
                            _vlmax = vlen / (0x8 << sew) / 8;
                        }
                    }
                } else {
                    if(lmul == 0){
                        _vlmax = vlen / (0x8 << sew);
                    } else if(lmul == 1) {
                        _vlmax = vlen / (0x8 << sew) * 2;
                    } else if(lmul == 2) {
                        _vlmax = vlen / (0x8 << sew) * 4;
                    } else if(lmul == 3) {
                        _vlmax = vlen / (0x8 << sew) * 8;
                    }
                }

                unsigned<32> _avl = uimm;
                unsigned<32> _vl = 0;
                if(_avl <= _vlmax) {
                   _vl = _avl;
                } else if(_avl >= (2*_vlmax)) {
                   _vl = _vlmax;
                } else {
                  // TODO: check
                  // _vl = (_avl % 0x2) ?  _avl/2 + 1 : _avl / 2; // ceil (AVL/2)
                  _vl = _vlmax;
                }

                CSR[VL_ADDR] = _vl;
                CSR[VTYPE_ADDR] = vtype_result;
                if(rd != 0) X[rd] = _vl;
                CSR[VSTART_ADDR] = 0;
            }
        }

        VSETVL {
            encoding: 1'b1 :: 6'b000000 :: rs2[4:0] :: rs1[4:0] :: 3'b111 :: rd[4:0] :: 7'b1010111;
            assembly:"{name(rd)}, {name(rs1)}, {name(rs2)}";
            behavior: {

                // unsigned<11> zimm[11] = X[rs2];
                // unsigned<3> sew[3]  =  vtype_extractSEW(zimm);
                // unsigned<3> lmul[3] =  vtype_extractLMUL(zimm);
                // unsigned<1> vta[1]  =  vtype_extractTA(zimm);
                // unsigned<1> vma[1]  =  vtype_extractMA(zimm);
                unsigned<11> zimm   = X[rs2];
                unsigned<3> sew  =  vtype_extractSEW(zimm);
                unsigned<3> lmul =  vtype_extractLMUL(zimm);
                unsigned<1> vta  =  vtype_extractTA(zimm);
                unsigned<1> vma  =  vtype_extractMA(zimm);

                unsigned<XLEN> _vlmax = 0;
                // unsigned<XLEN> _illmask = 0;
                unsigned<32> vtype_result = zimm;

                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                if (sew == 0b011 && XLEN == 32) {
                    vtype_result = (1 << (XLEN - 1));
                }

                if (lmul & 4){
                    // _illmask = (1 << (XLEN-1));
                    if(lmul == 6){
                        _vlmax = _vlen / (0x8 << sew) / 4;
                    }else if(lmul == 7){
                        _vlmax = _vlen / (0x8 << sew) / 2;
                    }else{
                        // For XLEN=32: unsupported!
                        if (XLEN == 32) {
                            vtype_result = (1 << (XLEN - 1));
                        } else {
                            _vlmax = _vlen / (0x8 << sew) / 8;
                        }
                        // _vlmax = _vlen / (0x8 << sew) / 8;
                    }
                }else {
                    // _illmask = (0 << (XLEN-1));
                    if(lmul == 0){
                        _vlmax = _vlen / (0x8 << sew);
                    }else if(lmul == 1){
                        _vlmax = _vlen / (0x8 << sew) *2;
                    }else if(lmul == 2){
                        _vlmax = _vlen / (0x8 << sew) *4;
                    }else if(lmul == 3){
                        _vlmax = _vlen / (0x8 << sew) *8;
                    }
                }
                unsigned<32> _avl = 0;
                if (rs1 != 0){
                    _avl = X[rs1];
                }else if(rd != 0){
                    _avl = ~0;
                }else{
                    _avl = CSR[VL_ADDR];
                }

                unsigned<32> _vl = 0;

                if(_avl <= _vlmax){
                   _vl = _avl;
                }else if(_avl >= (2*_vlmax)){
                   _vl = _vlmax;
                }else{
                  // TODO: check
                   // _vl = (_avl % 0x2) ? _avl/2 +1 : _avl/2; // ceil (AVL/2)
                   _vl = _vlmax;
                }

                CSR[VL_ADDR] = _vl;
                // CSR[VTYPE_ADDR] = _illmask | zimm;
                CSR[VTYPE_ADDR] = vtype_result;
                if(rd != 0) X[rd] = _vl;
                CSR[VSTART_ADDR] = 0;
            }

        }

        // 7. Vector Loads and Stores

        // Unitstride, 8 bit element
        VLE8_V {
            encoding: 3'b000 :: 1'b0 :: 2'b00 :: vm[0:0] :: 5'b00000 :: rs1[4:0] :: 3'b000 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {

                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b000);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_unitstride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        // Unitstride, 16 bit element
        VLE16_V {
            encoding: 3'b000 :: 1'b0 :: 2'b00 :: vm[0:0] :: 5'b00000 :: rs1[4:0] :: 3'b101 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {

                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b101);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_unitstride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        // Unitstride, 32 bit element
        VLE32_V {
            encoding: 3'b000 :: 1'b0 :: 2'b00 :: vm[0:0] :: 5'b00000 :: rs1[4:0] :: 3'b110 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {

                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b110);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_unitstride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        // Strided, 8 bit element
        VLSE8_V {
            encoding: 3'b000 :: 1'b0 :: 2'b10 :: vm[0:0] :: rs2[4:0] :: rs1[4:0] :: 3'b000 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {
                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b000);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_stride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1], (unsigned<16>)X[rs2]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        VLSE16_V {
            encoding: 3'b000 :: 1'b0 :: 2'b10 :: vm[0:0] :: rs2[4:0] :: rs1[4:0] :: 3'b101 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {
                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b101);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_stride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1], (unsigned<16>)X[rs2]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        VLSE32_V {
            encoding: 3'b000 :: 1'b0 :: 2'b10 :: vm[0:0] :: rs2[4:0] :: rs1[4:0] :: 3'b110 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {
                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b110);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR]*8;

                unsigned<XLEN> ret = etiss_vload_encoded_stride(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1], (unsigned<16>)X[rs2]); // V, MEM[-1],
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        VLM_V {
            encoding: 3'b000 :: 1'b0 :: 2'b00 :: vm[0:0] :: 5'b01011 :: rs1[4:0] :: 3'b000 :: vd[4:0] :: 7'b0000111;
            assembly:"{name(vd)}, {name(rs1)}, {name(vm)}";
            behavior: {
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR] * 8;

                unsigned<XLEN> ret = etiss_vload_mask(V, vm, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1]);
                if(ret != 0){
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else{
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }

        // 7.6. Vector Indexed Instructions
        VLOXEI8_V {
            encoding: 3'b000 :: 1'b0 :: 2'b11 :: vm[0:0] :: vs2[4:0] :: rs1[4:0] :: 3'b000 :: vd[4:0] :: 7'b0000111;
            assembly: "{name(vd)}, {name(rs1)}, name{{vs2}}, {name(vm)}";
            behavior: {
                unsigned<XLEN> _vtype = CSR[VTYPE_ADDR];
                unsigned<XLEN> _eew = vcfg_concatEEW(1'b0, 3'b000);
                unsigned<XLEN> _vstart = CSR[VSTART_ADDR];
                unsigned<XLEN> _vl = CSR[VL_ADDR];
                unsigned<XLEN> _vlen = CSR[VLENB_ADDR] * 8;

                unsigned<XLEN> ret = etiss_vload_encoded_index(V, _vtype, vm, _eew, vd, _vstart, _vlen, _vl, (unsigned<64>)X[rs1], vs2);
                if(ret != 0) {
                    CSR[VSTART_ADDR] = ret >> 8;
                    raise(0, 2);
                } else {
                    CSR[VSTART_ADDR] = 0;
                }
            }
        }


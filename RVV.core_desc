            encoding: 3'b000 :: 1'b0 :: 2'b11 :: vm[0:0] :: vs2[4:0] :: rs1[4:0] :: 3'b110 :: vd[4:0] :: 7'b0000111;
            assembly: "{name(vd)}, {name(rs1)}, name{{vs2}}, {name(vm)}";
